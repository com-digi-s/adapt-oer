USER=your-account
PASS=your-password
GITLAB_ACCESS_TOKEN=...
# mongodb
MONGODB_PORT=27017
DB_HOST=127.0.0.1
DB_NAME=adapt
SECRET_KEY=123456790
# adapt authoring
BUILDS_DIR=/path/to/adapt_authoring/temp/tenantId/adapt_framework/courses
AUTHORING_DOMAIN=https://your.authoring.url

# Shared LXP export: the tested wrapper is already included.
# Use comdigi-compose/.env.dist for the existing Docker stack.
LXP_WRAPPER_ZIP=./static/lxp-wrapper.zip
LXP_WRAPPER_SHA256=322f281ad57bae275dae141f07c6bd1a4c41bce65e7b702c71975be313c16d32
# Keep this identity unchanged for the lifetime of the AAT source installation.
LXP_ORIGIN_ID=https://your.authoring.url
# Persist the whole instance directory, including locks and catalogue backups.
LXP_REGISTRY_PATH=./instance/lxp-source-registry.json
LXP_CATALOGUE=./static/lxp-catalogue.json
LXP_CATALOGUE_STORE_PATH=./instance/lxp-catalogue.json
LXP_ASSESSMENT_TEMPLATE=./static/assessment-template.zip
LXP_TARGET_PROFILE_ID=scorm-1.2-conservative
LXP_AAT_BUILD_PROFILE=aat-core-build-v1
